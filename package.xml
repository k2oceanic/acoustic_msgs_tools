<?xml version="1.0"?>
<package format="3">
  <name>acoustic_msgs_tools</name>
  <version>0.0.0</version>
  <description>Utility tools for working with marine acoustic messages.</description>

  <maintainer email="kris@todo.todo">kris</maintainer>
  <license>MIT</license>

  <!-- Build system and message generation (ROS 2 style) -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Runtime and interface dependencies -->
  <depend>std_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>marine_acoustic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_sensor_msgs</depend>

  <!-- Export ament-specific info -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
